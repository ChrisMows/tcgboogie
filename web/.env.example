# Website settings. On Hostinger, add these under the web app's Environment Variables (never commit real values).
# Locally, copy this file to .env.local.

# Postgres connection string: our database on the VPS (keep the real value in a password manager), e.g.
#   postgresql://tcgboogie_app:<password>@staging.tcgboogie.com:5432/tcgboogie?sslmode=verify-full
DATABASE_URL=

# The site's public address. Needed on Hostinger, or sign-in links point at the internal server address.
AUTH_URL=https://tcgboogie.com

# Random secret that protects sign-in sessions. Generate one with:  npx auth secret
AUTH_SECRET=

# Who can use the site. Admins get Premium plus an admin bar to preview the site as a Free member.
ADMIN_EMAILS=
# "invite" (only ADMIN_EMAILS and ALLOWED_EMAILS can create accounts) or "open" (anyone)
SIGNUP_MODE=invite
ALLOWED_EMAILS=

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
# Authorized redirect URI: https://tcgboogie.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Discord sign-in (discord.com/developers -> BoogieBot -> OAuth2). Redirect: https://tcgboogie.com/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Email sign-in links, sent from your Hostinger mailbox (Hostinger -> Emails -> support@tcgboogie.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@tcgboogie.com

# eBay Partner Network campaign ID (10 digits, EPN dashboard -> Campaigns). Adds affiliate tracking to every eBay link.
EBAY_CAMPAIGN_ID=

# PokemonPriceTracker API key: TCGplayer prices for price watches (same key the bot uses). Without it, a sample catalog is used.
PPT_API_KEY=

# Local preview only: show every page with sample data, no database needed. Never set this on Hostinger.
DEMO_MODE=

# Price-alert sender (app/api/cron/price-alerts). A Hostinger cron job calls it every few hours.
# Optional: with CRON_SECRET set, a call with "Authorization: Bearer <secret>" can run it more often than every 20 min.
CRON_SECRET=
# Locks the alert dispatch endpoints the deal bot calls (/api/deals/dispatch, /api/watches/dispatch). Put the SAME
# long random value in the bot's .env on the server too. Until it's set, those endpoints run at most every 30 seconds.
DISPATCH_SECRET=
# Discord DMs for alerts: the same bot token the Discord bot uses (BoogieBot). Members must share a server with the bot.
DISCORD_BOT_TOKEN=
# Text alerts (Premium) through Twilio: Account SID, Auth Token, and your Twilio phone number like +18885551234
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Card payments (Stripe). Start with the test key (sk_test_...), then switch to sk_live_... at launch and press
# "Set up Stripe" in the admin panel again. STRIPE_WEBHOOK_SECRET is optional (the button creates the webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
