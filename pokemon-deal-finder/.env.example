# Copy this file to ".env" and fill in your values. Never share the .env file.

# eBay developer keys (developer.ebay.com > Application Keys > Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Discord bot token (discord.com/developers/applications > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# Optional: only needed if you run start_finder.bat (webhook mode) instead of the bot
DISCORD_WEBHOOK_URL=
